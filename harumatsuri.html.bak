<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<style>
  @page { size: Letter; margin: 0; }
  :root{
    --ink:#211f1c; --indigo:#2d4b39; --indigo2:#385a45; --navy:#21392b;
    --washi:#f5efe2; --washi2:#efe7d6; --card:#fbf7ee; --line:#d9cfba;
    --sakura:#e7b3c0; --sakura2:#f2d5dd; --sakuradeep:#c97e92;
    --verm:#c05a7c; --verm2:#a04763; --gold:#a98a54;
    --serif:"Noto Serif CJK JP", serif;
    --sans:"Noto Sans CJK JP", sans-serif;
  }
  *{ box-sizing:border-box; margin:0; padding:0; }
  html,body{ background:#cfcfcf; }
  body{ font-family:var(--sans); color:var(--ink); -weasy-font-feature-settings:"palt"; }

  .page{
    width:8.5in; height:11in; position:relative; overflow:hidden;
    background:var(--washi); page-break-after:always;
  }
  .page:last-child{ page-break-after:auto; }
  .dark{ background:var(--indigo); color:#f3ecdd; }

  .bg{ position:absolute; inset:0; background-size:cover; background-position:center; }
  .scrim{ position:absolute; inset:0; }

  /* shared bits */
  .pad{ position:absolute; inset:0; padding:0.74in 0.78in; }
  .kicker{ font-size:9.5pt; letter-spacing:.24em; text-transform:uppercase;
           color:var(--verm); font-weight:700; }
  .kicker .jp{ font-family:var(--serif); letter-spacing:.06em; margin-right:.5em; color:var(--verm); }
  .dark .kicker, .dark .kicker .jp{ color:var(--sakura); }
  .title{ font-family:var(--serif); font-weight:700; color:var(--indigo);
          line-height:1.04; letter-spacing:.01em; }
  .dark .title{ color:#fbf6ec; }
  h1.title{ font-size:33pt; }
  .lede{ font-size:11pt; line-height:1.66; color:#34302a; }
  .dark .lede{ color:#e8e0cf; }
  p{ font-size:10.4pt; line-height:1.64; color:#3b372f; }
  .dark p{ color:#dcd4c3; }
  p + p{ margin-top:.62em; }

  .rule{ width:46px; height:3px; background:var(--verm); border-radius:2px; }
  .hairline{ height:1px; background:var(--line); }

  /* hanko stamp */
  .hanko{ width:.66in; height:.66in; border-radius:50%; background:var(--indigo);
          color:#fff7ef; display:flex; align-items:center; justify-content:center;
          font-family:var(--serif); font-size:21pt; transform:rotate(-5deg);
          box-shadow: inset 0 0 0 2px rgba(255,247,239,.55), inset 0 0 0 5px var(--indigo); }
  .hanko.sq{ border-radius:8px; }

  .mark{ display:flex; align-items:center; gap:9px; }
  .mark img{ height:.42in; }
  .mark .wm{ font-family:var(--serif); font-size:12.5pt; color:var(--indigo); letter-spacing:.04em; }
  .dark .mark .wm{ color:#f3ecdd; text-shadow:0 1px 3px rgba(0,0,0,.5); }
  .dark .mark img{ filter:drop-shadow(0 1px 2px rgba(0,0,0,.45)); }
  .fmark{ position:absolute; bottom:.36in; left:.78in; }
  .mark.onimg .wm{ color:#fff; text-shadow:0 1px 3px rgba(0,0,0,.45); }
  .mark.onimg img{ filter:drop-shadow(0 1px 2px rgba(0,0,0,.4)); }

  .pagenum{ position:absolute; bottom:.5in; font-size:9pt; letter-spacing:.18em;
            color:var(--indigo); }
  .dark .pagenum{ color:#cfc6b4; text-shadow:0 1px 3px rgba(0,0,0,.55); }
  .pagenum.l{ left:.78in; } .pagenum.r{ right:.78in; text-align:right; }
  .footmark{ position:absolute; bottom:.46in; left:50%; transform:translateX(-50%);
             font-family:var(--serif); font-size:9.5pt; color:#9a917f; letter-spacing:.1em; }

  .seifoot{ position:absolute; left:0; right:0; bottom:0; height:.5in; overflow:hidden; opacity:.5; }
  .seifoot img{ width:100%; }

  /* ===================== COVER ===================== */
  #cover .scrim{ background:
      linear-gradient(to top, rgba(16,30,22,.92) 4%, rgba(16,30,22,.62) 30%, rgba(18,32,24,.10) 58%, rgba(18,32,24,.18) 100%); }
  #cover .topbar{ position:absolute; top:.62in; left:.7in; right:.7in;
      display:flex; align-items:center; justify-content:flex-end; }
  #cover .topbar .lab{ font-size:9pt; letter-spacing:.26em; color:#f0e7d6; text-transform:uppercase; }
  #cover .block{ position:absolute; left:.7in; right:.7in; bottom:.92in; color:#fff; }
  #cover .jpttl{ font-family:var(--serif); font-weight:700; font-size:84pt; color:#fff;
      line-height:.98; letter-spacing:.04em; text-shadow:0 2px 18px rgba(0,0,0,.35); }
  #cover .romaji{ font-family:var(--serif); font-size:25pt; letter-spacing:.42em; color:#fff;
      margin:.16in 0 .02in; padding-left:.05em; }
  #cover .sub{ font-size:11pt; letter-spacing:.04em; color:#f4ecdc; }
  #cover .meta{ margin-top:.26in; display:flex; align-items:center; gap:.22in; }
  #cover .meta .pk{ font-size:9.5pt; letter-spacing:.24em; text-transform:uppercase;
      color:#fff; border:1px solid rgba(255,255,255,.5); padding:.07in .2in; border-radius:30px; }
  #cover .meta .dt{ font-size:11pt; color:#f4ecdc; letter-spacing:.05em; }
  #cover .sakcorner{ position:absolute; top:1.5in; right:.8in; width:.7in; opacity:.92; }
  #cover .orglogo{ position:absolute; right:.72in; bottom:.92in; width:2.5in; height:2.5in;
      border-radius:16px; overflow:hidden; box-shadow:0 10px 26px rgba(0,0,0,.42); border:3px solid rgba(255,255,255,.9); }

  /* ===================== CONTENTS ===================== */
  #toc .photo{ position:absolute; top:0; bottom:0; left:0; width:3.35in; }
  #toc .photo .edge{ position:absolute; top:0; bottom:0; right:0; width:.14in; background:var(--verm); }
  #toc .right{ position:absolute; top:0; bottom:0; left:3.35in; right:0; padding:1.05in .5in 1in .82in; }
  #toc ol{ list-style:none; margin-top:.55in; }
  #toc li{ display:flex; align-items:baseline; padding:.3in 0; border-bottom:1px solid var(--line); }
  #toc li .no{ font-family:var(--serif); font-size:21pt; color:var(--verm); width:.72in; font-weight:700; }
  #toc li .nm{ font-size:13pt; color:var(--indigo); letter-spacing:.02em; flex:1; }
  #toc li .jp{ font-family:var(--serif); font-size:11pt; color:#8c8472; letter-spacing:.04em; white-space:nowrap; padding-left:.16in; }

  /* ===================== ABOUT ===================== */
  #about .photoR{ position:absolute; top:.74in; right:.78in; width:3.05in; height:4.6in;
      border:6px solid #fff; box-shadow:0 8px 22px rgba(40,30,15,.13); }
  #about .photoB{ position:absolute; left:.78in; top:5.55in; width:3.5in; height:3.35in;
      border:6px solid #fff; box-shadow:0 8px 22px rgba(40,30,15,.13); }
  #about .col{ position:absolute; top:2.0in; left:.78in; width:3.55in; }
  #about .pull{ font-family:var(--serif); font-size:16pt; line-height:1.4; color:var(--indigo);
      margin-top:.3in; padding-left:.2in; border-left:3px solid var(--verm); }
  #about .pull .jp{ display:block; color:var(--verm); font-size:13pt; margin-bottom:.06in; }
  #about .hk{ position:absolute; top:.78in; right:.84in; z-index:3; }

  /* ===================== WHAT IS ===================== */
  #what .seibg{ position:absolute; inset:0; opacity:.10; }
  #what .seibg img{ width:100%; }
  #what .photo{ position:absolute; left:0; right:0; bottom:0; height:4.05in; }
  #what .photo .top{ position:absolute; top:0; left:0; right:0; height:.7in;
      background:linear-gradient(to bottom, var(--indigo), rgba(22,35,63,0)); }
  #what .callout{ position:absolute; bottom:4.32in; right:.78in;
      background:var(--verm); color:#fff; padding:.12in .24in; border-radius:6px;
      font-size:9.5pt; letter-spacing:.1em; }

  /* ===================== NUMBERS ===================== */
  #nums .hero{ position:absolute; top:0; left:0; right:0; height:3.05in; }
  #nums .hero .sc{ position:absolute; inset:0; background:linear-gradient(to top, rgba(18,32,24,.86), rgba(18,32,24,.28)); }
  #nums .hero .htxt{ position:absolute; left:.78in; bottom:.36in; color:#fff; }
  #nums .grid{ position:absolute; top:3.05in; left:0; right:0; bottom:0;
      padding:.5in .7in .8in; display:flex; flex-wrap:wrap; gap:.0in; }
  #nums .cell{ width:25%; padding:.26in .2in; text-align:center; border-bottom:1px solid var(--line); }
  #nums .cell:nth-child(-n+4){ border-top:0; }
  #nums .cell .big{ font-family:var(--serif); font-size:30pt; font-weight:700; color:var(--indigo); line-height:1; }
  #nums .cell .big .u{ font-size:14pt; color:var(--verm); }
  #nums .cell .lab{ font-size:8.6pt; line-height:1.3; color:#5c5446; margin-top:.1in; letter-spacing:.02em; }
  #nums .vr{ } 
  #nums .note{ position:absolute; bottom:.5in; left:0; right:0; text-align:center;
      font-size:8.4pt; color:#9a917f; letter-spacing:.06em; }

  /* ===================== EXPERIENCE ===================== */
  #exp .stage{ position:absolute; top:1.95in; left:.5in; right:.5in; bottom:.62in; }
  .tile{ position:absolute; background-size:cover; background-position:center;
         box-shadow:0 6px 16px rgba(40,30,15,.14); }
  .tile .chip{ position:absolute; left:0; bottom:0; background:rgba(20,34,26,.82); color:#fff;
       font-size:8.4pt; letter-spacing:.08em; padding:.05in .14in; }
  .tile .chip .jp{ font-family:var(--serif); color:var(--sakura); margin-right:.4em; }

  /* ===================== WHY ===================== */
  #why .col{ position:absolute; top:2.0in; left:.78in; width:4.05in; }
  #why .photo{ position:absolute; top:2.0in; right:.78in; width:2.7in; height:3.7in;
      border:6px solid #fff; box-shadow:0 8px 22px rgba(40,30,15,.13); }
  #why .callout{ position:absolute; right:.78in; bottom:1.0in; width:2.7in;
      background:var(--indigo); color:#fff; padding:.22in; border-radius:8px; }
  #why .callout .n{ font-family:var(--serif); font-size:25pt; line-height:1; color:#fff; }
  #why .callout .t{ font-size:9pt; margin-top:.08in; color:#d7e0c8; letter-spacing:.04em; color:#e7e0d0; }

  /* ===================== BUDGET ===================== */
  #budget .cards{ position:absolute; top:2.25in; left:.78in; right:.78in; bottom:1.0in;
      display:flex; flex-direction:column; justify-content:space-between; }
  #budget .bc{ display:flex; gap:.24in; padding:.16in 0; align-items:center; }
  #budget .bc + .bc{ border-top:1px solid var(--line); }
  #budget .bc .ic{ width:.64in; height:.64in; flex:0 0 auto; border-radius:10px; background:var(--washi2);
      display:flex; align-items:center; justify-content:center; font-family:var(--serif);
      font-size:21pt; color:var(--verm); border:1px solid var(--line); }
  #budget .bc .tx h3{ font-size:12.5pt; color:var(--indigo); letter-spacing:.02em; }
  #budget .bc .tx p{ font-size:10pt; margin-top:.04in; color:#574f42; }
  #budget .glance{ position:absolute; left:.78in; right:.78in; bottom:.85in;
      background:var(--indigo); color:#fff; border-radius:10px; padding:.26in .34in; }
  #budget .glance .hd{ font-size:9pt; letter-spacing:.22em; text-transform:uppercase; color:var(--sakura); }
  #budget .glance .row{ display:flex; justify-content:space-between; align-items:center;
      padding:.1in 0; border-bottom:1px dashed rgba(255,255,255,.28); font-size:10.5pt; }
  #budget .glance .row:last-child{ border-bottom:0; }
  #budget .glance .fill{ font-family:var(--serif); color:#fff; letter-spacing:.04em;
      border-bottom:2px solid var(--sakura); min-width:1.5in; text-align:center; padding-bottom:2px; color:#cdbfa2; }
  #budget .glance .tag{ font-size:8pt; color:#bdb4a0; margin-top:.12in; letter-spacing:.04em; }


  /* ===================== THANK YOU ===================== */
  #thanks .hero{ position:absolute; top:0; left:0; right:0; height:3.7in; }
  #thanks .hero .sc{ position:absolute; inset:0; background:linear-gradient(to top, var(--washi) 2%, rgba(245,239,226,.25) 40%, rgba(245,239,226,0) 75%); }
  #thanks .body{ position:absolute; top:3.95in; left:.8in; right:.8in; }
  #thanks .sign{ margin-top:.26in; font-family:var(--serif); }
  #thanks .sign .nm{ font-size:14pt; color:var(--indigo); }
  #thanks .sign .ti{ font-size:10pt; color:#6f6757; font-family:var(--sans); letter-spacing:.03em; margin-top:.03in; }
  #thanks .contact{ position:absolute; left:.8in; right:.8in; bottom:1.15in;
      display:flex; gap:.5in; align-items:center; padding-top:.2in; border-top:2px solid var(--verm); }
  #thanks .contact .it .k{ font-size:8pt; letter-spacing:.2em; text-transform:uppercase; color:var(--verm); }
  #thanks .contact .it .v{ font-size:10.5pt; color:var(--indigo); margin-top:.03in; }
  #thanks .contact .hk{ margin-left:auto; }
  #thanks .datel{ position:absolute; bottom:.55in; left:.8in; right:.8in; text-align:center;
      font-family:var(--serif); font-size:9.5pt; color:#9a917f; letter-spacing:.14em; }
</style>
</head>
<body>

<!-- ============ 1 · COVER ============ -->
<section class="page" id="cover">
  <div class="bg" style="background-image:url('data:image/jpeg;base64,')"></div>
  <div class="scrim"></div>
  <div class="topbar">
    <div class="lab">JASA @ University of Maryland</div>
  </div>
  <div class="block">
    <div style="font-size:10pt;letter-spacing:.3em;text-transform:uppercase;color:#f3ead9;margin-bottom:.12in;">JASA Spring Festival</div>
    <div class="jpttl">春祭り</div>
    <div class="romaji">HARUMATSURI</div>
    <div class="meta">
      <span class="pk">Sponsorship Packet</span>
      <span class="dt">Spring 2027</span>
    </div>
  </div>
  <div class="orglogo"><div class="bg" style="background-image:url('data:image/jpeg;base64,')"></div></div>
</section>

<!-- ============ 2 · CONTENTS ============ -->
<section class="page" id="toc">
  <div class="photo">
    <div class="bg" style="background-image:url('data:image/jpeg;base64,')"></div>
    <div class="edge"></div>
  </div>
  <div class="right">
    <div class="kicker"><span class="jp">目次</span>Contents</div>
    <h1 class="title" style="margin-top:.16in;font-size:40pt;">Inside this<br>packet</h1>
    <ol>
      <li><span class="no">01</span><span class="nm">About JASA</span><span class="jp">私たちについて</span></li>
      <li><span class="no">02</span><span class="nm">What Is Harumatsuri</span><span class="jp">春祭りとは</span></li>
      <li><span class="no">03</span><span class="nm">By the Numbers</span><span class="jp">数字で見る</span></li>
      <li><span class="no">04</span><span class="nm">The Experience</span><span class="jp">当日の様子</span></li>
      <li><span class="no">05</span><span class="nm">Why Sponsor Us</span><span class="jp">ご支援のお願い</span></li>
      <li><span class="no">06</span><span class="nm">Where Support Goes</span><span class="jp">予算の内訳</span></li>
      <li><span class="no">07</span><span class="nm">Thank You &amp; Contact</span><span class="jp">ありがとう</span></li>
    </ol>
  </div>
  <div class="mark fmark onimg"><img src="data:image/png;base64,"><span class="wm">JASA</span></div>
  <div class="pagenum r">02</div>
</section>

<!-- ============ 3 · ABOUT ============ -->
<section class="page" id="about">
  <div class="pad" style="padding-bottom:0;">
    <div class="kicker"><span class="jp">私たちについて</span>About Us</div>
    <h1 class="title" style="margin-top:.16in;">About JASA</h1>
    <div class="rule" style="margin-top:.16in;"></div>
  </div>
  <div class="col">
    <p>The Japanese American Student Association's (JASA) mission is to unite and grow the Japanese/Japanese-American student community present within UMD. To increase awareness and understanding of Japanese culture and language. To serve, represent, and advocate for the Asian Pacific American community as a whole.</p>
    <p>We work to create an environment that we can build a community from, whether it be with Japanese/Japanese-American students, or those who are interested in some aspect of Japanese culture, language, or arts.</p>
  </div>
  <div class="photoR"><div class="bg" style="background-image:url('data:image/jpeg;base64,');background-position:center 24%"></div></div>
  <div class="photoB"><div class="bg" style="background-image:url('data:image/jpeg;base64,')"></div></div>
  <div class="mark fmark"><img src="data:image/png;base64,"><span class="wm">JASA</span></div>
  <div class="pagenum r">03</div>
</section>

<!-- ============ 4 · WHAT IS ============ -->
<section class="page dark" id="what">
  <div class="seibg"><img src="data:image/svg+xml;base64,"></div>
  <div class="pad" style="padding-bottom:0;">
    <div class="kicker"><span class="jp">春祭りとは</span>Our Largest Event</div>
    <h1 class="title" style="margin-top:.16in;font-size:36pt;">What Is Harumatsuri?</h1>
    <div class="rule" style="margin-top:.16in;background:var(--sakura);"></div>
    <div style="max-width:5.6in;margin-top:.26in;">
      <p style="font-size:11pt;">Harumatsuri is JASA's largest event of the year! It is an spring festival that features carnival-style booths and J-pop stage performances, all while in a cherry-blossom-themed decorated space!</p>
      <p>Some of our activities include cork shooting, net fishing, Omikuji, Tanabata, and photo booths.</p>
      <p>We bring together over 250 students to our Harumatsuri, spreading Japanese culture and cultivating a welcoming UMD community!</p>
    </div>
  </div>
  <div class="photo">
    <div class="bg" style="background-image:url('data:image/jpeg;base64,');background-position:center 38%;"></div>
    <div class="top"></div>
  </div>
  <div class="mark fmark"><img src="data:image/png;base64,"><span class="wm">JASA</span></div>
  <div class="pagenum r">04</div>
</section>

<!-- ============ 5 · BY THE NUMBERS ============ -->
<section class="page" id="nums">
  <div class="hero">
    <div class="bg" style="background-image:url('data:image/jpeg;base64,');background-position:center 42%;"></div>
    <div class="sc"></div>
    <div class="htxt">
      <div class="kicker" style="color:var(--sakura);"><span class="jp" style="color:var(--sakura);">数字で見る</span>2026 at a Glance</div>
      <h1 class="title" style="color:#fff;margin-top:.1in;font-size:34pt;">Harumatsuri<br>by the numbers</h1>
    </div>
  </div>
  <div class="grid">
    <div class="cell"><div class="big">1,200</div><div class="lab">presale food &amp; game tickets</div></div>
    <div class="cell"><div class="big">13</div><div class="lab">live performances</div></div>
    <div class="cell"><div class="big">12<span class="u">+</span></div><div class="lab">food, game &amp; craft stalls</div></div>
    <div class="cell"><div class="big">300<span class="u">+</span></div><div class="lab">handmade decorations</div></div>
    <div class="cell"><div class="big">5</div><div class="lab">group stage dances</div></div>
    <div class="cell"><div class="big">40<span class="u">+</span></div><div class="lab">student volunteers</div></div>
    <div class="cell"><div class="big">7½<span class="u" style="font-size:11pt;"> hrs</span></div><div class="lab">afternoon into the night</div></div>
    <div class="cell"><div class="big" style="font-size:22pt;">Free</div><div class="lab">admission — all are welcome</div></div>
  </div>
  <div class="note">Figures from JASA's Spring 2026 Harumatsuri on McKeldin Mall.</div>
  <div class="mark fmark"><img src="data:image/png;base64,"><span class="wm">JASA</span></div>
  <div class="pagenum r">05</div>
</section>

<!-- ============ 6 · EXPERIENCE ============ -->
<section class="page" id="exp">
  <div class="pad" style="padding-bottom:0;height:auto;">
    <div class="kicker"><span class="jp">当日の様子</span>On the Day</div>
    <h1 class="title" style="margin-top:.16in;">The Experience</h1>
    <div class="rule" style="margin-top:.16in;"></div>
  </div>
  <div class="stage">
    <!-- big taiko -->
    <div class="tile" style="left:0;top:0;width:4.55in;height:3.6in;background-image:url('data:image/jpeg;base64,');">
      <div class="chip"><span class="jp">音楽</span>Live music on the main stage</div></div>
    <!-- kimono tall -->
    <div class="tile" style="right:0;top:0;width:2.85in;height:3.6in;background-image:url('data:image/jpeg;base64,');background-position:center 30%;">
      <div class="chip"><span class="jp">歌</span>Singers on stage</div></div>
    <!-- bottom row of three -->
    <div class="tile" style="left:0;top:3.78in;width:2.42in;height:3.55in;background-image:url('data:image/jpeg;base64,');">
      <div class="chip"><span class="jp">ゲーム</span>Festival games</div></div>
    <div class="tile" style="left:2.55in;top:3.78in;width:2.42in;height:3.55in;background-image:url('data:image/jpeg;base64,');background-position:center 28%;">
      <div class="chip"><span class="jp">おみくじ</span>Omikuji fortunes</div></div>
    <div class="tile" style="left:5.10in;top:3.78in;width:2.30in;height:3.55in;background-image:url('data:image/jpeg;base64,');background-position:center 22%;">
      <div class="chip"><span class="jp">演奏</span>Student bands</div></div>
  </div>
  <div class="mark fmark"><img src="data:image/png;base64,"><span class="wm">JASA</span></div>
  <div class="pagenum r">06</div>
</section>

<!-- ============ 7 · WHY SPONSOR ============ -->
<section class="page" id="why">
  <div class="pad" style="padding-bottom:0;">
    <div class="kicker"><span class="jp">ご支援のお願い</span>Why Sponsor</div>
    <h1 class="title" style="margin-top:.16in;">Why sponsor us</h1>
    <div class="rule" style="margin-top:.16in;"></div>
  </div>
  <div class="col">
    <p>Harumatsuri is entirely student-run and student-funded. Each year we cover it through a mix of SGA funding, ticket and food sales, and sponsorships like yours — and every year we hope to do more: richer cultural programming, more performers and stalls, and keeping the festival free and open to all.</p>
    <p>Your support is what makes that possible. It puts your name in front of <strong>1,000+ students</strong> and the wider DMV Japanese and Asian-American community, and it directly funds an event that introduces thousands of people to Japanese culture each spring.</p>
    <p>We'd be honored to have you stand with us — a contribution of any size makes a difference, in whatever form fits your goals. Get in touch and we'll find the right way to work together.</p>
  </div>
  <div class="photo"><div class="bg" style="background-image:url('data:image/jpeg;base64,')"></div></div>
  <div class="callout">
    <div class="n">1,200</div>
    <div class="t">presale tickets sold in advance last spring — before a single guest walked in.</div>
  </div>
  <div class="mark fmark"><img src="data:image/png;base64,"><span class="wm">JASA</span></div>
  <div class="pagenum r">07</div>
</section>

<!-- ============ 8 · BUDGET ============ -->
<section class="page" id="budget">
  <div class="pad" style="padding-bottom:0;">
    <div class="kicker"><span class="jp">予算の内訳</span>The Budget</div>
    <h1 class="title" style="margin-top:.16in;">Where your support goes</h1>
    <div class="rule" style="margin-top:.16in;"></div>
    <p style="margin-top:.16in;max-width:5.4in;">Every dollar goes straight back into the festival. Here is where it is spent:</p>
  </div>
  <div class="cards">
    <div class="bc"><div class="ic">食</div><div class="tx"><h3>Festival food &amp; drink</h3><p>Takoyaki, daifuku, ramune and cotton candy — catered from local vendors and hand-made fresh on the mall.</p></div></div>
    <div class="bc"><div class="ic">場</div><div class="tx"><h3>Equipment &amp; contracts</h3><p>The main stage, tents, tables and chairs, sound and lighting, and a generator — the backbone of the event and our largest cost.</p></div></div>
    <div class="bc"><div class="ic">飾</div><div class="tx"><h3>Decorations &amp; props</h3><p>Lanterns, hand-painted banners, the Tanabata wishing tree, and hundreds of folded origami that bring the mall to life.</p></div></div>
    <div class="bc"><div class="ic">遊</div><div class="tx"><h3>Games &amp; prizes</h3><p>Materials for Shateki, goldfish-scooping and omikuji, plus the prize raffle that gives back to our community.</p></div></div>
    <div class="bc"><div class="ic">舞</div><div class="tx"><h3>Performances &amp; programming</h3><p>Hosting taiko, kimono dance, and a dozen student acts on the main stage.</p></div></div>
  </div>
  <div class="mark fmark"><img src="data:image/png;base64,"><span class="wm">JASA</span></div>
  <div class="pagenum r">08</div>
</section>


